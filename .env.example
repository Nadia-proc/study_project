# Шаблон настроек: скопировать в .env.
# Уровень логов: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO
# Попыток на задание
MAX_ATTEMPTS=3
# Заданий в тренировке
TASKS_PER_SESSION=10
# Тренировок в памяти, старые удаляются
MAX_SESSIONS=1000
# Засчитывать «е» вместо «ё»
ACCEPT_E_FOR_YO=true
# Пусто = случайные задания
RANDOM_SEED=
